# Frontend dev / preview settings (copy to .env.local if you need them; nothing here is a secret).
# Where the agents' API runs (backend/main.py). Default http://127.0.0.1:8010
LOS_API=http://127.0.0.1:8010
# Where the FULL LOS server runs, for dedupe's "New application" form (/api/v1/fos/*) and sign-in (/api/v1/auth/*).
# Leave empty when it is the same server as LOS_API.
FOS_API=
# Per-agent overrides (optional): ELG_API DDP_API DCP_API BV_API ITR_API ROV_API CRV_API LGV_API PRV_API COL_API FRS_API
